# Base-URL til Lægemiddelstyrelsens medicinpriser API.
# Default virker — denne variabel er kun til at pege på en proxy
# eller en alternativ host hvis nødvendigt.
MEDICINPRISER_API_BASE=https://api.medicinpriser.dk/v1

# Sekunder server-cachen holder API-svar (default: 3600 = 1 time).
# Priser opdateres hver 14. dag, så længere TTL er fint.
MEDICINPRISER_CACHE_SECONDS=3600

# Sæt til 1 for at logge alle API-kald i terminalen — nyttigt når man
# debugger om endpoint-stierne matcher det reelle API.
MEDICINPRISER_DEBUG=0
