# ---------------------------------------------------------------------------
# Ladepause PoC — miljøvariabler
#
# Kopiér til .env.local og udfyld. Alle nøgler er KUN nødvendige for at køre
# berigelses-pipelinen (Fase 1 / scripts/). Selve webappen kan startes uden
# nøgler — den viser eksempeldata fra data/sample-enriched.json indtil du har
# kørt pipelinen og bygget den lokale database.
# ---------------------------------------------------------------------------

# Open Charge Map — gratis. Registrér en nøgle på https://openchargemap.org/site/profile/applications
# Uden nøgle falder scriptet tilbage til det statiske seed-sæt (data/seed-stations.json).
OCM_API_KEY=

# Google Places (New) — KRÆVER billing i Google Cloud.
# VIGTIGT: Sæt et budgetloft på $10 (billing alert/quota) i Google Cloud-projektet,
# jf. projekt-briefen. Bruges kun af scripts/02-fetch-pois.ts, én gang pr. station.
GOOGLE_PLACES_API_KEY=

# Claude API — genererer resuméer + "bedst til"-tags (scripts/03-generate-summaries.ts).
# Kan også hentes fra en `ant auth login`-profil; så kan denne stå tom.
ANTHROPIC_API_KEY=

# Google Maps JS API-nøgle til FRONTEND-kortet (offentlig, browser-eksponeret).
# Uden denne viser appen kun listevisning + et fald-tilbage-kort. Kan afgrænses
# til dit domæne i Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Radius (meter) for POI-søgning omkring hver station. Brief foreslår 500-800m.
POI_RADIUS_METERS=700

# Claude-model til resumé-generering (default claude-opus-5).
CLAUDE_MODEL=claude-opus-5
